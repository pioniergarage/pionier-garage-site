---
import "../styles/global.css";
import Banner from "../components/Banner.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DevToolbar from "../components/dev/DevToolbar.astro";

type Props = {
  title?: string;
  description?: string;
};

const { title, description } = Astro.props;

// Maps your path conditional animation smoothly
const root_anim =
  Astro.originPathname.length < 5 ? "animate-appear-slowly" : "";

const not_release = import.meta.env.DEV || import.meta.env.PUBLIC_STAGING != undefined;
---

<!doctype html>
<html lang={Astro.currentLocale} class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="margin-0 min-h-screen bg-bg text-primary font-body">
    <div
      class="relative w-full z-10 flex flex-col justify-center min-h-screen"
    >
      <Banner />
      <Header id="header" class={root_anim} />
      <main id="main-content" class="flex flex-row flex-1 flex-wrap w-full">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
  {not_release && <DevToolbar/>}
  <script>
    const header = document.getElementById("header");

    if (header) {
      // Der Banner scrollt mit und liegt ueber dem Header - der Hintergrund des
      // Headers wird deshalb erst eingeblendet, sobald der Banner durchgelaufen
      // ist und der Header oben haengen bleibt.
      const banner = document.querySelector("[data-banner]");
      let offset = banner instanceof HTMLElement ? banner.offsetHeight : 0;

      const update = () => {
        header.classList.toggle("active", window.scrollY > offset + 50);
      };

      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", () => {
        offset = banner instanceof HTMLElement ? banner.offsetHeight : 0;
        update();
      });
      update();
    }
  </script>
</html>
