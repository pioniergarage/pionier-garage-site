---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import RichTextBlock from "../../components/blocks/RichTextBlock.astro";
import type { BlockProps } from "../../components/types/types";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => {
    let finalSlug = post.id
      .replace(/(^|\/)index$/, "")
      .replace(/\/+/g, "/")
      .replace(/^\/|\/$/g, "");

    return {
      params: { slug: finalSlug === "" ? undefined : finalSlug },
      props: post,
    };
  });
}
type Props = CollectionEntry<"pages">;
type BlockPropsRichText = Pick<BlockProps<"rich-text">, "style">;

const post = Astro.props;
---

<PageLayout title={post.data.title}>
  <RichTextBlock style={{ alignment: "center", size: "full",className:"max-w-[600px]" }} content={post.body} />
</PageLayout>