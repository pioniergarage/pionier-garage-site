---
import { twMerge } from "tailwind-merge";
import type { BlockProps } from "../types/types";
import { sectionVariants } from "../../styles/style-mapping";
import { getLocale } from "../../utils/i18n";
import { localized } from "../../utils/utils";

type Props = BlockProps<"form">;

const { url, style } = Astro.props;
const formUrl = url?.replace(/^https:\/\/tally\.so\/embed\//, "https://tally.so/r/");
const labels = {
  de: { privacy: "Datenschutzhinweise", open: "Formular bei Tally öffnen" },
  en: { privacy: "Privacy notice", open: "Open form on Tally" },
  fr: { privacy: "Politique de confidentialité", open: "Ouvrir le formulaire sur Tally" },
}[getLocale(Astro.currentLocale)];
---

{formUrl && (
  <section class={twMerge(sectionVariants(style), style.className, "p-5")}>
    <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-4">
      <a class="underline" href={localized("privacy", Astro.currentLocale)}>{labels.privacy}</a>
      <a class="underline" href={formUrl} rel="noreferrer">{labels.open}</a>
    </div>
  </section>
)}
