---
import { twMerge } from "tailwind-merge";
import BlockRenderer from "../BlockRenderer.astro";
import { sectionVariants } from "../../styles/style-mapping";
import type { ColumnWidth } from "../../content.config";
import type { BlockProps } from "../types/types";

type Props = BlockProps<"columns">;

const { columns, gap, verticalAlign, style } = Astro.props;

// A 12-track grid is the smallest one that divides cleanly into halves, thirds
// and quarters, so every width the CMS offers maps onto whole tracks.
// The classes are spelled out in full because Tailwind scans source text —
// building them at runtime (`md:col-span-${n}`) would leave them unmatched.
const widthClasses: Record<ColumnWidth, string> = {
  "1/4": "md:col-span-3",
  "1/3": "md:col-span-4",
  "1/2": "md:col-span-6",
  "2/3": "md:col-span-8",
  full: "md:col-span-12",
  "3/4": "md:col-span-9",
};

const gapClasses: Record<NonNullable<Props["gap"]>, string> = {
  none: "gap-0",
  small: "gap-3",
  medium: "gap-6",
  large: "gap-10",
};

const alignClasses: Record<NonNullable<Props["verticalAlign"]>, string> = {
  top: "items-start",
  center: "items-center",
  bottom: "items-end",
};

const wrapperClasses = sectionVariants({
  alignment: style?.alignment,
  size: style?.size,
});

// Below `md` every column spans the single available track, so the layout
// collapses into the source order instead of squeezing text into slivers.
const gridClasses = twMerge(
  "grid grid-cols-1 md:grid-cols-12 w-full",
  gapClasses[gap],
  alignClasses[verticalAlign],
  style?.className,
);
---

{
  columns.length > 0 && (
    <section class={wrapperClasses}>
      <div class={gridClasses}>
        {columns.map((column) => (
          <div class={twMerge("flex flex-col min-w-0", widthClasses[column.width])}>
            {column.blocks.map((block) => (
              <BlockRenderer block={block} />
            ))}
          </div>
        ))}
      </div>
    </section>
  )
}
