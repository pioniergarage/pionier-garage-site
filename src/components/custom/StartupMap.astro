---
import { pb } from "../../lib/pocketbase";
import StartupMapRenderer from "../startup-map/StartupMap";
import type { StartupMapViewMilestone } from "../startup-map/types";
import { getLocale } from "../../utils/i18n";

const locale = getLocale(Astro.currentLocale);
const translationPreference =
  locale === "fr" ? ["FR", "EN", "DE"] : locale === "de" ? ["DE", "EN"] : ["EN", "DE"];

function findTranslation<T extends { locale?: string }>(translations?: T[]): T | undefined {
  if (!Array.isArray(translations)) return undefined;

  for (const preferredLocale of translationPreference) {
    const translation = translations.find(
      (item) => item.locale?.toUpperCase() === preferredLocale,
    );
    if (translation) return translation;
  }

  return undefined;
}

const [milestones, entries] = await Promise.all([
  pb.collection("startupMapMilestones").getFullList({
    sort: "order",
    expand: "startupMapMilestone_Translations_via_milestone",
  }),
  pb.collection("startupMapEntries").getFullList({
    expand:
      "startupMapEntry_Translations_via_entry,category,category.startupMapCategory_Translations_via_category",
  }),
]);

// Zusammenbauen
const map: StartupMapViewMilestone[] = milestones.map((milestone) => ({
  id: milestone.id,
  name: findTranslation(
    milestone.expand?.startupMapMilestone_Translations_via_milestone,
  )?.name ?? milestone.name ?? milestone.id,
  entries: entries
    .filter((e) => e.milestone === milestone.id)
    .map((entry) => ({
      id: entry.id,
      name: entry.name,
      description: findTranslation(
        entry.expand?.startupMapEntry_Translations_via_entry,
      )?.description,
      category: {
        name:
          findTranslation(
            entry.expand?.category?.expand
              ?.startupMapCategory_Translations_via_category,
          )?.name ?? entry.expand?.category?.name,
        color: entry.expand?.category?.color,
      },
    }))
    .sort((a, b) => {
      const categoryComparison = a.category.name.localeCompare(
        b.category.name,
        locale,
      );

      if (categoryComparison !== 0) {
        return categoryComparison;
      }

      return a.name.localeCompare(b.name, locale);
    }),
}));
---

{/* 
  Translated .startups-block__surface:
  - padding-top: 10px -> pt-[10px]
  - display: flex -> flex
  - flex-direction: column -> flex-col
  - gap: 30px -> gap-[30px]
*/}
<div class="pt-2.5 flex flex-col gap-7.5">
  <StartupMapRenderer client:load map={map} locale={locale} />
</div>
